USE [PenFed_Raw_PII]
GO
SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO
CREATE PROCEDURE [dbo].[sp_Master_Transfer_Xref_Daily]
AS
DECLARE @UnionStatement		VARCHAR(MAX)
DECLARE @CreationStatement	VARCHAR(MAX)
DECLARE @XrefStatement		VARCHAR(MAX)
DECLARE @PeriodID			VARCHAR(8) = convert(varchar(8),cast(GETDATE()-1 as date),112)
DECLARE @PeriodMTH			VARCHAR(6) = convert(varchar(6),cast(GETDATE()-1 as date),112)
SELECT @UnionStatement = CASE WHEN @UnionStatement IS NULL 
                 THEN 'SELECT CAST('''+SUBSTRING(TABLE_NAME, 14, 8)+''' AS INT) AS PeriodDate, * FROM '
                 ELSE @UnionStatement + 'UNION ALL SELECT CAST('''+SUBSTRING(TABLE_NAME, 14, 8)+''' AS INT) AS PeriodDate, * FROM ' END +
              '' + TABLE_CATALOG +'.dbo.'+ TABLE_NAME +
              CHAR(13) + CHAR(10)
   FROM PenFed_Raw_PII.INFORMATION_SCHEMA.TABLES WHERE TABLE_NAME LIKE 'Raw_Transfer_'+@PeriodID+'_BANK75'
   ORDER BY Table_Name

SET @CreationStatement ='

IF OBJECT_ID(''PenFed_Raw_PII.dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+''',''U'') IS NOT NULL
DROP TABLE PenFed_Raw_PII.dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+';
	
SELECT   
IDENTITY(INT, 1, 1)																			AS [TransferUniqueId]
--,CAST( AS INT)																	AS BankId														       
,CAST('+@PeriodID+' AS INT)																	AS PeriodId                
--,CAST('+@PeriodID+' AS INT)														AS BankPeriod												       
, ISNULL(CAST(CAST(''75'' + REPLICATE(''0'',16) AS NUMERIC(18,0))	
        + CAST(CASE	
                  WHEN ISNUMERIC(LTRIM(RTRIM(A.CHD_ACCOUNT_NUMBER_NEW))) != 0	
                       AND LTRIM(RTRIM(A.CHD_ACCOUNT_NUMBER_NEW)) NOT IN (''.'','''') THEN	
                        LTRIM(RTRIM(A.CHD_ACCOUNT_NUMBER_NEW))	
                  ELSE NULL
               END AS NUMERIC(18,0)) AS NUMERIC(18,0)),0)									AS AccountId_New
,ISNULL(CAST(CAST(''75'' + REPLICATE(''0'',16) AS NUMERIC(18,0))	
        + CAST(CASE	
                  WHEN ISNUMERIC(LTRIM(RTRIM(A.CHD_ACCOUNT_NUMBER_OLD))) != 0	
                       AND LTRIM(RTRIM(A.CHD_ACCOUNT_NUMBER_OLD)) NOT IN (''.'','''') THEN	
                        LTRIM(RTRIM(A.CHD_ACCOUNT_NUMBER_OLD))	
                  ELSE NULL
               END AS NUMERIC(18,0)) AS NUMERIC(18,0)),0)									AS AccountId_Old                 
,A.*
INTO PenFed_Raw_PII.dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+'
FROM 
(
'+@UnionStatement+'
) A
WHERE LTRIM(RTRIM(A.COMPANY_CARD)) = ''N''

ALTER TABLE PenFed_Raw_PII.dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+'
REBUILD PARTITION = ALL WITH (DATA_COMPRESSION = PAGE)
'
EXEC (@CreationStatement)
DELETE dbo.Master_Transfer_Xref_Daily WHERE Periodid = @Periodid
SET @XrefStatement = '

WITH Tree
  AS (
      -- Transfers Linked To Existing Parent Accounts
      SELECT A.ParentAccountID AS ParentAccountId
           , A.AccountId_New AS AccountId_Old
           , B.AccountId_New
           , B.CHD_ACCT_TRANSFER_DATE AS AcctTransferDate
        FROM dbo.Master_Transfer_Xref_Daily AS A
       INNER JOIN dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+' AS B
          ON A.AccountId_New = B.AccountId_Old
       WHERE A.PeriodID < '+@PeriodMTH+'
       UNION ALL
      -- Transfers With New Parent Accounts
      SELECT A.AccountId_Old AS ParentAccountId
           , A.AccountId_Old
           , A.AccountId_New
           , A.CHD_ACCT_TRANSFER_DATE AS AcctTransferDate
        FROM dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+' AS A
        LEFT OUTER JOIN dbo.Master_Transfer_Xref_Daily AS B
          ON A.AccountId_Old = B.AccountId_New
        LEFT OUTER JOIN dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+' AS C
          ON A.AccountId_Old = C.AccountId_New
       WHERE B.ParentAccountID IS NULL
         AND C.TransferUniqueId IS NULL
       UNION ALL
      -- Multiple Transfers Within A Single Period
      SELECT P.ParentAccountId AS ParentAccountId
           , P.AccountId_New AS AccountId_Old
           , C.AccountId_New AS AccountId
           , C.CHD_ACCT_TRANSFER_DATE AS AcctTransferDate
        FROM Tree AS P
       INNER JOIN dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+' AS C
          ON P.AccountId_New = C.AccountId_Old
      )
INSERT INTO dbo.Master_Transfer_Xref_Daily (BankID, PeriodID, BankPeriod, ParentAccountID, AccountId_Old, AccountId_New, CHD_ACCT_TRANSFER_DATE)
SELECT 75 AS BankID
     , '+@PeriodID+' AS PeriodID
     , 75'+@PeriodMTH+' AS BankPeriod
     , Tree.ParentAccountId
     , Tree.AccountId_Old
     , Tree.AccountId_New
     , Tree.AcctTransferDate AS CHD_ACCT_TRANSFER_DATE
  FROM Tree
  LEFT OUTER JOIN dbo.Master_Transfer_Xref_Daily AS MTX
    ON Tree.AccountId_Old = MTX.AccountId_Old
   AND Tree.AccountId_New = MTX.AccountId_New
WHERE MTX.AccountId_Old IS NULL
IF OBJECT_ID(''PenFed_Raw_PII.dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+''',''U'') IS NOT NULL
DROP TABLE PenFed_Raw_PII.dbo.Raw_Transfer_Daily_Temp_'+@PeriodID+';
'
EXEC (@XrefStatement)
GO

