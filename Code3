import duckdb

# This creates a local file automatically
con = duckdb.connect("banking.duckdb")

# Create schema
con.execute("""
CREATE SCHEMA IF NOT EXISTS l2_reporting_sch;
""")

# Create table
con.execute("""
CREATE TABLE IF NOT EXISTS l2_reporting_sch.factaccountsnapshot_final (
accountid BIGINT,
open_date DATE,
monthsonbooks INTEGER,
endingbalance DOUBLE,
endingbalancedeliquentaccount DOUBLE,
endingbalance2cpdaccount DOUBLE,
creditlimit_utilizationrate DOUBLE,
decilekey INTEGER,
flagdebitactive INTEGER
);
""")

# Insert sample rows
con.execute("""
INSERT INTO l2_reporting_sch.factaccountsnapshot_final VALUES
(1, '2021-01-10', 6, 50000, 10000, 5000, 0.45, 3, 1),
(2, '2020-03-15', 12, 120000, 30000, 15000, 0.82, 8, 0),
(3, '2022-06-01', 3, 30000, 0, 0, 0.25, 2, 1);
""")

print("Table created and data inserted")

result=con.sql("""
select * from factaccountsnapshot_final limit 5
""").fetchall()
print(result)

con.close()



