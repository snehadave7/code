cube(`Orders`, {
  sql: `
    SELECT *
    FROM (
      SELECT 'new' AS status, 100 AS total_amount
      UNION ALL
      SELECT 'processed', 200
      UNION ALL
      SELECT 'shipped', 300
    ) t
  `,

  measures: {
    count: {
      type: `count`
    },

    totalAmount: {
      sql: `total_amount`,
      type: `sum`
    }
  },

  dimensions: {
    status: {
      sql: `status`,
      type: `string`
    }
  }
});
