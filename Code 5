# Write your MySQL query statement below
with cte1 as (
select player_id,event_date
from activity
having (player_id,DATE_ADD(event_date, INTERVAL 1 DAY)) in (
    select player_id,event_date from activity
)
)
select round(count(c.player_id)/ count(distinct(a.player_id)),2) as fraction
from activity a 
left join cte1 c
on a.event_date=c.event_date
