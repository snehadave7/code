CREATE TABLE fact_account_snapshot (
    account_id SERIAL PRIMARY KEY,
    period_id INT,
    open_date DATE,
    months_on_books INT,
    revenue_decile INT,
    credit_utilization_rate NUMERIC(5,2),
    ending_balance NUMERIC(14,2),
    delinquent_balance NUMERIC(14,2),
    balance_2cpd NUMERIC(14,2),
    debit_active_flag BOOLEAN
);
