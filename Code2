cube(`AccountSnapshot`, {
  sql: `SELECT * FROM fact_account_snapshot`,

  description: `Monthly account snapshot for balance and delinquency analysis`,

  measures: {
    totalEndingBalance: {
      sql: `ending_balance`,
      type: `sum`,
      description: `Total ending balance`
    },

    delinquentBalance: {
      sql: `delinquent_balance`,
      type: `sum`,
      description: `Total delinquent balance`
    },

    balance2CPD: {
      sql: `balance_2cpd`,
      type: `sum`,
      description: `Balance for accounts 2 cycles past due`
    },

    accountCount: {
      type: `count`,
      description: `Number of accounts`
    }
  },

  dimensions: {
    periodId: {
      sql: `period_id`,
      type: `number`
    },

    openYear: {
      sql: `EXTRACT(YEAR FROM open_date)`,
      type: `number`,
      description: `Year account was opened`
    },

    monthsOnBooks: {
      sql: `months_on_books`,
      type: `number`
    },

    revenueDecile: {
      sql: `revenue_decile`,
      type: `number`
    },

    creditUtilizationSegment: {
      sql: `
        CASE
          WHEN credit_utilization_rate < 0.3 THEN 'Low'
          WHEN credit_utilization_rate < 0.7 THEN 'Medium'
          ELSE 'High'
        END
      `,
      type: `string`
    },

    debitActiveFlag: {
      sql: `debit_active_flag`,
      type: `boolean`
    }
  }
});


